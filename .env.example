# Copy to .env.local (gitignored) and fill in per environment.
# Only VITE_-prefixed vars are ever bundled to the browser — never put the service_role
# key behind a VITE_ prefix.

# Local dev (supabase start prints these; the anon key is the same fixed value on every machine)
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=

# Server-only — used by src/lib/api/admin-client.ts to create auth.users when an admin
# grants a customer contact app access (src/lib/customers/access-server.ts). `supabase
# start` also prints this. Read via process.env, never import.meta.env, and never given
# a VITE_ prefix — it must never reach the browser bundle.
SUPABASE_SERVICE_ROLE_KEY=

# Vercel Preview / production: the hosted Supabase project's URL + anon key + service role key.
