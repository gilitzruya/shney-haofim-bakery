# Copy to .env.local (gitignored) and fill in per environment.
# Only the publishable/anon key ever goes here — never the service_role key.

# Local dev (supabase start prints these; the anon key is the same fixed value on every machine)
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=

# Vercel Preview / production: the hosted Supabase project's URL + anon key.
